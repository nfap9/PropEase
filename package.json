{
  "name": "apartment-ultra",
  "version": "0.1.0",
  "private": true,
  "description": "Apartment Ultra - 多租户公寓管理系统",
  "scripts": {
    "dev:api": "PORT=8000 pnpm --filter apartment-ultra-api dev",
    "dev:web": "pnpm --filter apartment-ultra-tenant dev",
    "dev:admin": "pnpm --filter apartment-ultra-admin dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "pnpm -r run build",
    "lint": "pnpm --filter apartment-ultra-api run lint && pnpm --filter apartment-ultra-tenant run lint && pnpm --filter apartment-ultra-admin run lint",
    "format": "prettier --write \"api/src/**/*.ts\" \"tenant-web/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"api/src/**/*.ts\" \"tenant-web/src/**/*.{ts,tsx}\"",
    "type-check": "pnpm --filter apartment-ultra-api exec prisma generate && pnpm --filter apartment-ultra-api run type-check && pnpm --filter apartment-ultra-tenant run type-check && pnpm --filter apartment-ultra-admin run type-check",
    "type-check:mobile": "pnpm --filter mobile run type-check",
    "test": "pnpm --filter apartment-ultra-api exec prisma generate && pnpm --filter apartment-ultra-api run test && pnpm --filter apartment-ultra-tenant run test:run && pnpm --filter apartment-ultra-admin run test:run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report e2e/report"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@playwright/test": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "pnpm": {
    "overrides": {
      "next": "14.2.35",
      "eslint-config-next": "14.2.35",
      "react": "^18",
      "react-dom": "^18",
      "typescript": "^5",
      "axios": "^1.13.5",
      "@hookform/resolvers": "^5.2.2",
      "@tanstack/react-query": "^5.90.21",
      "@tanstack/react-table": "^8.21.3",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "date-fns": "^4.1.0",
      "lucide-react": "^0.575.0",
      "react-hook-form": "^7.71.2",
      "sonner": "^2.0.7",
      "tailwind-merge": "^3.5.0",
      "tailwindcss-animate": "^1.0.7",
      "zod": "^3.25.76"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
