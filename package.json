{
  "name": "apartment-ultra",
  "version": "0.1.0",
  "private": true,
  "description": "Apartment Ultra - 多租户公寓管理系统",
  "scripts": {
    "dev:api": "PORT=8000 pnpm --filter apartment-ultra-api dev",
    "dev:web": "pnpm --filter apartment-ultra-tenant dev",
    "dev:admin": "pnpm --filter apartment-ultra-admin dev",
    "build": "pnpm -r run build",
    "lint": "pnpm --filter apartment-ultra-api run lint && pnpm --filter apartment-ultra-tenant run lint:fix",
    "format": "prettier --write \"api/src/**/*.ts\" \"tenant-web/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"api/src/**/*.ts\" \"tenant-web/src/**/*.{ts,tsx}\"",
    "type-check": "pnpm --filter apartment-ultra-api run type-check && pnpm --filter apartment-ultra-tenant run type-check",
    "test": "pnpm --filter apartment-ultra-api run test && pnpm --filter apartment-ultra-tenant run test:run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report e2e/report",
    "seed:e2e": "pnpm --filter apartment-ultra-api run seed:e2e",
    "seed:e2e:clean": "pnpm --filter apartment-ultra-api run seed:e2e -- --clean"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
