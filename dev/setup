#!/bin/bash
# Setup development environment

set -e

echo "🚀 Setting up Apartment Ultra development environment..."

# Check dependencies
echo ""
echo "📋 Checking dependencies..."

if ! command -v docker &> /dev/null; then
    echo "❌ Docker is required but not installed."
    exit 1
fi

if ! command -v uv &> /dev/null; then
    echo "⚠️  uv is not installed. Installing..."
    curl -LsSf https://astral.sh/uv/install.sh | sh
fi

if ! command -v pnpm &> /dev/null; then
    echo "⚠️  pnpm is not installed. Installing..."
    npm install -g pnpm
fi

echo "✅ All dependencies are installed."

# Setup environment files
echo ""
echo "📝 Setting up environment files..."

cp -n docker/middleware.env.example docker/middleware.env 2>/dev/null || true
cp -n api/.env.example api/.env 2>/dev/null || true
cp -n web/.env.example web/.env.local 2>/dev/null || true

echo "✅ Environment files created."

# Start middleware
echo ""
echo "🐳 Starting Docker middleware..."
cd docker && docker compose -f docker-compose.middleware.yaml up -d
cd ..

# Wait for PostgreSQL
echo "⏳ Waiting for PostgreSQL..."
sleep 5

# Setup API
echo ""
echo "🔧 Setting up API..."
cd api
uv sync --dev
uv run alembic upgrade head
cd ..

# Setup Web
echo ""
echo "🌐 Setting up Web..."
cd web
pnpm install
cd ..

echo ""
echo "✅ Development environment setup complete!"
echo ""
echo "To start development:"
echo "  Terminal 1: make dev-api"
echo "  Terminal 2: make dev-web"
echo ""
echo "Or use Docker:"
echo "  make dev-docker"
