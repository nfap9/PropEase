// Apartment Ultra - 数据库由 Prisma 管理，状态/角色/编码等字段统一为 VARCHAR，不使用 PG ENUM

// ============================================================
// 公寓管理模块
// ============================================================

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// 用户账号（租客/住户）
model User {
  id            String   @id @db.VarChar(26)
  phone         String   @unique @db.VarChar(20)
  password_hash String   @db.VarChar(255)
  full_name     String   @db.VarChar(255)
  referral_code String?  @unique @db.VarChar(20)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  organization_memberships OrganizationMember[]
  notifications            Notification[]


  @@map("users")
}

// 组织/商户（公寓运营商）
model Organization {
  id          String   @id @db.VarChar(26)
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(100)
  type        String   @default("individual") @db.VarChar(20)
  notes       String?  @db.VarChar(1000)
  settings    Json?
  is_personal Boolean  @default(false)
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  members             OrganizationMember[]
  org_roles          OrgRole[]
  apartments          Apartment[]
  tenants             Tenant[]
  subscription        OrganizationSubscription?
  billing_orders      BillingOrder[]
  notification_templates  NotificationTemplate[]
  notification_deliveries NotificationDelivery[]

  @@map("organizations")
}

// 组织成员关系（用户加入组织）
model OrganizationMember {
  id              String   @id @db.VarChar(26)
  organization_id String   @db.VarChar(26)
  user_id         String   @db.VarChar(26)
  role_id         String   @db.VarChar(26)  // 关联 OrgRole
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role         OrgRole      @relation(fields: [role_id], references: [id], onDelete: Restrict)

  @@index([user_id])
  @@index([organization_id])
  @@index([role_id])
  @@map("organization_members")
}

// 公寓（房源）
model Apartment {
  id               String    @id @db.VarChar(26)
  organization_id  String    @db.VarChar(26)
  name             String    @db.VarChar(255)
  address          String?   @db.VarChar(500)
  // 基本信息
  floors           Int?
  land_area        Decimal?  @db.Decimal(10, 2)
  total_area       Decimal?  @db.Decimal(10, 2)
  // 上游信息
  landlord_name    String?   @db.VarChar(100)
  landlord_contact String?   @db.VarChar(50)
  contract_start   DateTime? @db.Date
  contract_end     DateTime? @db.Date
  landlord_rent    Decimal?  @db.Decimal(10, 2)
  // 经营成本
  operating_cost   Decimal?  @db.Decimal(10, 2)
  description      String?   @db.VarChar(1000)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  organization   Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  rooms          Room[]
  config ApartmentConfig?

  @@index([organization_id])
  @@map("apartments")
}

// 房间
model Room {
  id           String   @id @db.VarChar(26)
  apartment_id String   @db.VarChar(26)
  room_number  String   @db.VarChar(50)
  layout       String?  @db.VarChar(50)
  status       String   @default("available") @db.VarChar(20)
  maintenance  Boolean  @default(false)
  area         Decimal? @db.Decimal(10, 2)
  facilities   Json?
  notes        String?  @db.VarChar(500)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  apartment        Apartment        @relation(fields: [apartment_id], references: [id], onDelete: Cascade)
  leases           Lease[]
  utility_readings UtilityReading[]
  pricing          RoomPricing?

  @@index([status])
  @@index([apartment_id])
  @@map("rooms")
}

// 房间定价（月租金）
model RoomPricing {
  id          String   @id @db.VarChar(26)
  room_id     String   @unique @db.VarChar(26)
  monthly_rent Decimal @db.Decimal(10, 2)
  effective_date DateTime @default(now())
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  room Room @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@map("room_pricing")
}

// 租客
model Tenant {
  id                String   @id @db.VarChar(26)
  organization_id   String   @db.VarChar(26)
  name              String   @db.VarChar(255)
  phone             String?  @db.VarChar(50)
  sms_opt_out       Boolean  @default(false)
  sms_opt_out_at    DateTime?
  sms_opt_out_reason String? @db.VarChar(255)
  id_card           String?  @db.VarChar(50)
  emergency_contact String?  @db.VarChar(255)
  emergency_phone   String?  @db.VarChar(50)
  notes             String?  @db.VarChar(500)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  leases       Lease[]
  notification_deliveries NotificationDelivery[]

  @@index([organization_id])
  @@map("tenants")
}

// 租约
model Lease {
  id               String    @id @db.VarChar(26)
  room_id          String    @db.VarChar(26)
  tenant_id        String    @db.VarChar(26)
  start_date       DateTime  @db.Date
  end_date         DateTime? @db.Date
  rental_type      String    @default("monthly") @db.VarChar(20)
  billing_day      Int       @default(1)
  monthly_rent     Decimal   @db.Decimal(10, 2)
  deposit          Decimal   @default(0) @db.Decimal(10, 2)
  water_rate       Decimal   @default(0) @db.Decimal(10, 4)
  electricity_rate Decimal   @default(0) @db.Decimal(10, 4)
  is_active        Boolean   @default(true)
  notes            String?   @db.VarChar(500)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  room   Room   @relation(fields: [room_id], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  bills  Bill[]
  notification_deliveries NotificationDelivery[]
  fee_items   LeaseFeeItem[]
  change_logs LeaseChangeLog[]

  @@index([room_id])
  @@index([room_id, is_active])
  @@index([tenant_id])
  @@index([is_active])
  @@map("leases")
}

// 租约费用项（租金、水电、管理费等周期费用）
model LeaseFeeItem {
  id           String    @id @db.VarChar(26)
  lease_id     String    @db.VarChar(26)
  fee_type_id  String?   @db.VarChar(26)
  fee_category String    @db.VarChar(20)
  fee_name     String    @db.VarChar(100)
  fee_amount   Decimal   @default(1) @db.Decimal(10, 2)
  fee_cycle    String    @db.VarChar(20)
  quantity     Decimal   @default(1) @db.Decimal(10, 2)
  notes        String?   @db.VarChar(500)
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  lease    Lease      @relation(fields: [lease_id], references: [id], onDelete: Cascade)
  feeType  ApartmentFeeItem? @relation(fields: [fee_type_id], references: [id])

  @@index([lease_id])
  @@map("lease_fee_items")
}

// 租约变更记录
model LeaseChangeLog {
  id                   String   @id @db.VarChar(26)
  lease_id             String   @db.VarChar(26)
  change_type          String   @db.VarChar(50)
  old_value            Json?
  new_value            Json?
  effective_from_year  Int?
  effective_from_month Int?
  reason               String?  @db.VarChar(500)
  created_by           String?  @db.VarChar(26)
  created_at           DateTime @default(now())

  lease Lease @relation(fields: [lease_id], references: [id], onDelete: Cascade)

  @@index([lease_id, created_at])
  @@index([effective_from_year, effective_from_month])
  @@map("lease_change_logs")
}

// 水电表读数记录
model UtilityReading {
  id                   String   @id @db.VarChar(26)
  room_id              String   @db.VarChar(26)
  period_year          Int
  period_month         Int
  reading_date         DateTime @db.Date
  water_reading        Decimal? @db.Decimal(10, 2)
  electricity_reading  Decimal? @db.Decimal(10, 2)
  water_previous       Decimal? @db.Decimal(10, 2)
  electricity_previous Decimal? @db.Decimal(10, 2)
  notes                String?  @db.VarChar(500)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  room Room @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@unique([room_id, period_year, period_month])
  @@index([room_id])
  @@index([period_year, period_month])
  @@map("utility_readings")
}

// 公寓配置（水电单价、费用项目）
model ApartmentConfig {
  id                         String   @id @db.VarChar(26)
  apartment_id               String   @unique @db.VarChar(26)
  water_price_per_unit       Decimal? @db.Decimal(10, 2)
  electricity_price_per_unit Decimal? @db.Decimal(10, 2)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  apartment Apartment        @relation(fields: [apartment_id], references: [id], onDelete: Cascade)
  fee_items ApartmentFeeItem[]

  @@map("apartment_configs")
}

// 公寓费用项目（平铺结构，如服务费、卫生费、网费）
model ApartmentFeeItem {
  id             String   @id @db.VarChar(26)
  apartment_id   String   @db.VarChar(26)
  category       String   @db.VarChar(20)  // fixed/utility/optional
  name           String   @db.VarChar(100) // 服务费、卫生费、网费
  amount         Decimal  @db.Decimal(10, 2)
  cycle          String   @db.VarChar(20)  // monthly/quarterly/yearly/one_time
  sort_order     Int      @default(0)
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  apartment       ApartmentConfig @relation(fields: [apartment_id], references: [id], onDelete: Cascade)
  bill_fee_items  BillFeeItem[]
  lease_fee_items LeaseFeeItem[]

  @@unique([apartment_id, name])
  @@index([apartment_id])
  @@map("apartment_fee_items")
}

// 账单（月度账单）
model Bill {
  id                 String   @id @db.VarChar(26)
  lease_id           String   @db.VarChar(26)
  bill_year          Int
  bill_month         Int
  due_date           DateTime @db.Date
  rent_amount        Decimal  @default(0) @db.Decimal(10, 2)
  deposit_amount     Decimal  @default(0) @db.Decimal(10, 2)
  water_amount       Decimal  @default(0) @db.Decimal(10, 2)
  electricity_amount Decimal  @default(0) @db.Decimal(10, 2)
  other_amount       Decimal  @default(0) @db.Decimal(10, 2)
  total_amount       Decimal  @db.Decimal(10, 2)
  paid_amount        Decimal  @default(0) @db.Decimal(10, 2)
  status             String   @default("pending") @db.VarChar(20)
  notes              String?  @db.VarChar(500)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  lease     Lease         @relation(fields: [lease_id], references: [id], onDelete: Cascade)
  payments  Payment[]
  fee_items BillFeeItem[]
  notification_deliveries NotificationDelivery[]

  @@unique([lease_id, bill_year, bill_month])
  @@index([lease_id])
  @@index([status])
  @@map("bills")
}

// 账单支付记录
model Payment {
  id             String   @id @db.VarChar(26)
  bill_id        String   @db.VarChar(26)
  amount         Decimal  @db.Decimal(10, 2)
  payment_date   DateTime @db.Date
  payment_method String   @default("cash") @db.VarChar(20)
  reference      String?  @db.VarChar(255)
  notes          String?  @db.VarChar(500)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  bill Bill @relation(fields: [bill_id], references: [id], onDelete: Cascade)

  @@map("payments")
}


// 账单费用明细（替代原来的 other_amount，记录各项费用）
model BillFeeItem {
  id           String    @id @db.VarChar(26)
  bill_id      String    @db.VarChar(26)
  fee_type_id  String    @db.VarChar(26)
  fee_category String    @db.VarChar(20)
  fee_name     String    @db.VarChar(100)
  fee_amount   Decimal   @default(1) @db.Decimal(10, 2)
  fee_cycle    String    @db.VarChar(20)
  quantity     Decimal   @default(1) @db.Decimal(10, 2)
  unit_price   Decimal   @db.Decimal(10, 2)
  amount       Decimal   @db.Decimal(10, 2)
  notes        String?   @db.VarChar(500)
  created_at   DateTime  @default(now())

  bill     Bill      @relation(fields: [bill_id], references: [id], onDelete: Cascade)
  feeType  ApartmentFeeItem @relation(fields: [fee_type_id], references: [id])

  @@index([bill_id])
  @@map("bill_fee_items")
}

// 组织角色（预制+自定义统一管理，如管理员、成员）
model OrgRole {
  id              String   @id @db.VarChar(26)
  organization_id String   @db.VarChar(26)
  name            String   @db.VarChar(50)
  description     String?  @db.VarChar(255)
  is_system       Boolean  @default(false)  // true=预制角色，不可删除/修改名称
  permissions     Json     @default("[]")   // 权限码数组
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization       @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  members      OrganizationMember[]

  @@unique([organization_id, name])
  @@index([organization_id])
  @@map("org_roles")
}

// 用户通知
model Notification {
  id              String   @id @db.VarChar(26)
  user_id         String   @db.VarChar(26)
  organization_id String   @db.VarChar(26)
  type            String   @db.VarChar(50)
  title           String   @db.VarChar(255)
  content         String   @db.VarChar(1000)
  is_read         Boolean  @default(false)
  extra_data      Json?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, is_read])
  @@map("notifications")
}

// 通知模板（按渠道、事件类型配置）
model NotificationTemplate {
  id              String   @id @db.VarChar(26)
  organization_id String   @db.VarChar(26)
  channel         String   @db.VarChar(20)
  event_type      String   @db.VarChar(50)
  name            String   @db.VarChar(100)
  content         String   @db.VarChar(1000)
  is_enabled      Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization Organization          @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  deliveries   NotificationDelivery[]

  @@unique([organization_id, channel, event_type])
  @@index([organization_id, channel])
  @@map("notification_templates")
}

// 通知投递记录
model NotificationDelivery {
  id                  String   @id @db.VarChar(26)
  organization_id     String   @db.VarChar(26)
  tenant_id           String?  @db.VarChar(26)
  lease_id            String?  @db.VarChar(26)
  bill_id             String?  @db.VarChar(26)
  template_id         String?  @db.VarChar(26)
  channel             String   @db.VarChar(20)
  event_type          String   @db.VarChar(50)
  recipient           String?  @db.VarChar(50)
  status              String   @db.VarChar(20)
  content             String   @db.VarChar(1000)
  provider_message_id String?  @db.VarChar(100)
  status_reason       String?  @db.VarChar(255)
  extra_data          Json?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  organization Organization         @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  tenant       Tenant?              @relation(fields: [tenant_id], references: [id], onDelete: SetNull)
  lease        Lease?               @relation(fields: [lease_id], references: [id], onDelete: SetNull)
  bill         Bill?                @relation(fields: [bill_id], references: [id], onDelete: SetNull)
  template     NotificationTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)

  @@index([organization_id, created_at])
  @@index([organization_id, status])
  @@index([tenant_id])
  @@index([bill_id])
  @@map("notification_deliveries")
}

// ============================================================
// 运营系统模块
// ============================================================

// 组织订阅（当前生效的订阅服务）
model OrganizationSubscription {
  id              String    @id @db.VarChar(26)
  organization_id String    @unique @db.VarChar(26)
  service_id      String    @db.VarChar(26)
  pricing_id      String?   @db.VarChar(26) // 购买的定价周期
  status          String    @default("active") @db.VarChar(20)
  billing_months  Int       @default(1) // 订阅月数
  start_date      DateTime  @db.Date
  end_date        DateTime? @db.Date
  auto_renew      Boolean   @default(true)
  trial_ends_at   DateTime? @db.Date
  next_service_id String?   @db.VarChar(26)
  cancel_reason   String?   @db.VarChar(500) // 取消原因
  limits_snapshot Json?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  organization Organization        @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  service      ServiceProduct      @relation("CurrentService", fields: [service_id], references: [id])
  pricing      ServicePricing?     @relation(fields: [pricing_id], references: [id], onDelete: SetNull)
  next_service ServiceProduct?     @relation("NextService", fields: [next_service_id], references: [id], onDelete: SetNull)
  billing_orders BillingOrder[]

  @@index([service_id])
  @@map("organization_subscriptions")
}

// 短信验证码
model SmsVerificationCode {
  id         String   @id @db.VarChar(26)
  phone      String   @db.VarChar(20)
  code       String   @db.VarChar(6)
  purpose    String   @db.VarChar(20)
  is_used    Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("sms_verification_codes")
}

// 运营后台管理员账号（无角色系统，所有账号权限相同）
model AdminUser {
  id                    String    @id @db.VarChar(26)
  username              String    @unique @db.VarChar(64)
  password_hash         String    @db.VarChar(255)
  name                  String    @db.VarChar(100)
  email                 String?   @db.VarChar(255)
  is_active             Boolean   @default(true)
  is_system             Boolean   @default(false)  // 系统预置账号不可删除
  last_login_at         DateTime?
  failed_login_attempts Int       @default(0)
  locked_until          DateTime?
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt

  @@map("admin_users")
}

// 平台配置（品牌信息等）
model PlatformConfig {
  id            String   @id @default("default") @db.VarChar(26)
  brand         Json?    @db.Json
  updated_at    DateTime @updatedAt

  @@map("platform_config")
}

// ============================================================
// 计费模块（新 - 用量付费统一架构）
// ============================================================

// 统一订单表（替代 SubscriptionOrder 和 UsageQuotaOrder）
model BillingOrder {
  id              String    @id @db.VarChar(26)
  order_no        String    @unique @db.VarChar(64)
  order_type      String    @db.VarChar(20)  // 'subscription' | 'usage'

  // 关联（subscription 必填 organization_id，usage 必填 user_id）
  organization_id String?   @db.VarChar(26)
  user_id         String?   @db.VarChar(26)

  // 服务产品（subscription 用）
  service_id      String?   @db.VarChar(26)
  pricing_id      String?   @db.VarChar(26)
  billing_months  Int?      // 订阅月数

  // 金额
  amount          Decimal   @db.Decimal(10, 2)
  original_amount Decimal?  @db.Decimal(10, 2)
  currency        String    @default("CNY") @db.VarChar(10)
  status          String    @default("pending") @db.VarChar(32)

  // 支付
  payment_method  String    @default("wechat_native") @db.VarChar(32)
  code_url        String?   @db.VarChar(512)
  wechat_transaction_id String? @db.VarChar(64)
  paid_at         DateTime?
  expires_at      DateTime

  // 折扣
  applied_discounts Json?
  total_discount    Decimal? @db.Decimal(10, 2)
  total_gift_months Int      @default(0)

  // 关联订阅
  subscription_id String?   @db.VarChar(26)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  organization     Organization?              @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  service          ServiceProduct?            @relation(fields: [service_id], references: [id])
  pricing          ServicePricing?            @relation(fields: [pricing_id], references: [id], onDelete: SetNull)
  subscription     OrganizationSubscription?   @relation(fields: [subscription_id], references: [id], onDelete: SetNull)

  @@index([organization_id])
  @@index([user_id])
  @@index([order_type])
  @@index([status])
  @@map("billing_orders")
}

// ============================================================
// 服务定价模块（新）
// ============================================================

// 服务产品（如基础版、高级版）
model ServiceProduct {
  id          String  @id @db.VarChar(26)
  name        String  @db.VarChar(100) // 服务名称
  code        String  @unique @db.VarChar(50) // 服务代码
  description String? @db.VarChar(500) // 服务描述

  // 服务内容限制
  max_organizations Int? // 最大组织数（null 表示不限制）
  max_apartments    Int  @default(1) // 最大公寓数
  max_rooms         Int  @default(100) // 最大房间数
  max_members       Int  @default(1) // 最大成员数

  // 状态
  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  pricing          ServicePricing[]
  subscriptions    OrganizationSubscription[] @relation("NextService")
  current_subs     OrganizationSubscription[] @relation("CurrentService")
  billing_orders   BillingOrder[]

  @@index([is_active])
  @@map("service_products")
}

// 服务定价（按时长定价，如1个月、3个月、12个月）
model ServicePricing {
  id         String  @id @db.VarChar(26)
  service_id String  @db.VarChar(26)
  months     Int // 购买时长（月）
  price      Decimal @db.Decimal(10, 2) // 价格

  is_active  Boolean @default(true)
  sort_order Int     @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  service       ServiceProduct             @relation(fields: [service_id], references: [id], onDelete: Cascade)
  subscriptions OrganizationSubscription[]
  billing_orders BillingOrder[]

  @@unique([service_id, months])
  @@index([service_id])
  @@map("service_pricing")
}


