# Application
APP_NAME=Apartment Ultra API
DEBUG=true
API_V1_PREFIX=/api/v1
# 开发环境标识：true 时启用验证码固定码(123456)、支付模拟等（NODE_ENV!==production 时自动为开发环境）
# IS_DEV=true

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/apartment_ultra

# Security
# 生产环境必须设置至少 32 个字符的密钥，不能使用默认值
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON array string 或 "*" 表示允许所有来源)
# 生产环境不能使用 "*"，必须指定具体域名
CORS_ORIGINS=["http://localhost:3000"]

# Admin seed (optional, used on first init)
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=Admin@123456

# Admin JWT
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 微信支付（套餐购买 Native 扫码支付，不配置则仅创建订单不调起支付）
# WECHAT_PAY_ENABLED=false
# WECHAT_MCH_ID=
# WECHAT_APP_ID=
# WECHAT_CERT_SERIAL_NO=
# WECHAT_APIV3_KEY=
# WECHAT_PAY_NOTIFY_URL_BASE=https://your-domain.com
# 私钥二选一：PEM 字符串或证书文件路径
# WECHAT_PRIVATE_KEY=
# WECHAT_PRIVATE_KEY_PATH=
