{
  "name": "apartment-ultra-api",
  "version": "0.1.0",
  "description": "Apartment Ultra API (Node/TypeScript, Express)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "dev:docker": "prisma db push && prisma generate && tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "export:openapi": "tsx scripts/export-openapi.ts",
    "migrate:plans-to-services": "tsx scripts/migrate-plans-to-services.ts"
  },
  "dependencies": {
    "@apartment-ultra/api-contract": "workspace:*",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.213.0",
    "@opentelemetry/instrumentation-express": "^0.61.0",
    "@opentelemetry/instrumentation-http": "^0.213.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@prisma/instrumentation": "^7.5.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "exceljs": "catalog:",
    "express": "^4.21.0",
    "ioredis": "^5.10.1",
    "node-cron": "^3.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ulid": "^2.3.0",
    "zod": "catalog:",
    "zod-to-openapi": "^0.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/node": "catalog:",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.18.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "1.6.1",
    "eslint": "catalog:",
    "eslint-plugin-import": "^2.28.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.4.2",
    "tsx": "^4.7.0",
    "typescript": "catalog:",
    "vitest": "1.6.1"
  },
  "engines": {
    "node": ">=18"
  }
}
