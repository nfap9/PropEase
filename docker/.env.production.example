# =========================================
# Apartment Ultra 生产环境配置
# =========================================
# 使用方式:
#   cp docker/.env.production.example .env.production
#   chmod 600 .env.production
#   docker compose -f docker/docker-compose.yaml --env-file .env.production up -d
# =========================================

# ---- 数据库 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=apartment_ultra

# ---- Redis ----
REDIS_PORT=6379

# ---- API ----
SECRET_KEY=your-jwt-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=["http://your-domain.com"]

# ---- 前端 ----
NEXT_PUBLIC_API_URL=http://your-domain.com/api/v1

# ---- 端口 ----
API_PORT=8000
TENANT_WEB_PORT=3000
ADMIN_WEB_PORT=8080
NGINX_PORT=80

# ---- Nginx ----
SERVER_NAME=your-domain.com

# ---- 微信支付（可选）----
WECHAT_PAY_ENABLED=false
# WECHAT_MCH_ID=
# WECHAT_APP_ID=
# WECHAT_APIV3_KEY=
# WECHAT_CERT_SERIAL_NO=
# WECHAT_PAY_NOTIFY_URL_BASE=
# WECHAT_PRIVATE_KEY=

# ---- 镜像标签（可选）----
# API_IMAGE_TAG=latest
# TENANT_WEB_IMAGE_TAG=latest
# ADMIN_WEB_IMAGE_TAG=latest

# ---- 资源限制（可选）----
# POSTGRES_MEMORY=1G
# API_MEMORY=1G
# TENANT_WEB_MEMORY=1G
# ADMIN_MEMORY=1G
