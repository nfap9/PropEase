# =========================================
# PropEase 生产环境配置
# =========================================
# 使用方式:
#   cp docker/.env.production.example .env.production
#   chmod 600 .env.production
#   docker compose -f docker/docker-compose.yaml --env-file .env.production up -d
#
#   叠加可观测性服务:
#   docker compose -f docker/docker-compose.yaml -f docker/docker-compose.observability.yaml --env-file .env.production up -d
# =========================================

# ---- 服务标识 ----
APP_NAME="PropEase API"

# ---- 数据库 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=apartment_ultra
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- API ----
SECRET_KEY=your-jwt-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=30
API_V1_PREFIX=/api/v1

# ---- CORS ----
CORS_ORIGINS=["http://your-domain.com"]

# ---- 前端 ----
VITE_API_URL=http://your-domain.com/api/v1

# ---- 端口（仅内部网络访问，不再对外暴露）----
# API_PORT=8000    # 仅内部容器通信
NGINX_PORT=80  # 唯一对外暴露的端口

# ---- Nginx ----
SERVER_NAME=your-domain.com

# ---- 微信支付（可选）----
WECHAT_PAY_ENABLED=false
# WECHAT_MCH_ID=
# WECHAT_APP_ID=
# WECHAT_APIV3_KEY=
# WECHAT_CERT_SERIAL_NO=
# WECHAT_PAY_NOTIFY_URL_BASE=
# WECHAT_PRIVATE_KEY=

# ---- 可观测性（OpenTelemetry，可选）----
# 默认关闭，设置为 true 启用
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---- Jaeger 端口（叠加 observability compose 时使用）----
# JAEGER_UI_PORT=16686
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318

# ---- 镜像标签（可选）----
# API_IMAGE_TAG=latest
# WEB_IMAGE_TAG=latest

# ---- 资源限制（可选）----
# POSTGRES_MEMORY=1G
# API_MEMORY=1G
# WEB_MEMORY=512M
