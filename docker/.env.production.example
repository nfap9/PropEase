# =========================================
# Apartment Ultra 生产环境配置
# =========================================
# 复制此文件为 .env.production 并修改配置
# cp docker/.env.production.example .env.production
# chmod 600 .env.production
# =========================================

# ---- 数据库配置 ----
POSTGRES_USER=apartment_admin
# 使用 openssl rand -base64 32 生成强密码
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=apartment_ultra

# ---- API 配置 ----
APP_NAME=Apartment Ultra API
# 使用 openssl rand -hex 64 生成 JWT 密钥
SECRET_KEY=your-jwt-secret-key-here
# 管理员初始密码（首次部署后建议修改）
ADMIN_INIT_PASSWORD=Admin@ChangeMe123
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS 配置 ----
# 允许的前端域名，JSON 数组格式
# 示例: ["http://your-server-ip"] 或 ["https://yourdomain.com"]
CORS_ORIGINS=["http://your-server-ip"]

# ---- 前端配置 ----
# 前端访问的 API 地址
# 示例: http://your-server-ip/api/v1 或 https://yourdomain.com/api/v1
NEXT_PUBLIC_API_URL=http://your-server-ip/api/v1

# ---- Nginx 配置 ----
# 服务器 IP 或域名（用于 Nginx server_name）
SERVER_NAME=your-server-ip

# ---- 微信支付配置（可选）----
WECHAT_PAY_ENABLED=false
# WECHAT_MCH_ID=
# WECHAT_APP_ID=
# WECHAT_APIV3_KEY=
# WECHAT_CERT_SERIAL_NO=
# WECHAT_PAY_NOTIFY_URL_BASE=
# WECHAT_PRIVATE_KEY=

# ---- 镜像标签（可选）----
API_TAG=latest
WEB_TAG=latest
