# =========================================
# Middleware environment variables
# =========================================
# Copy this file to middleware.env and modify as needed
# docker compose -f docker/docker-compose.middleware.yaml --env-file docker/middleware.env up -d

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=apartment_ultra
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
