# PropEase 前端 Dockerfile（构建产物通过共享卷供给 Nginx）
# 构建上下文为 monorepo 根目录

# ============================================
# Stage 1: 依赖安装
# ============================================
FROM node:20-alpine AS deps
WORKDIR /app

RUN corepack enable pnpm && pnpm config set registry https://registry.npmmirror.com

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json tsconfig.base.json
COPY tsconfig.react-package.json tsconfig.react-package.json
COPY api/package.json api/package.json
COPY tenant-web/package.json tenant-web/package.json
COPY admin-web/package.json admin-web/package.json
COPY packages/ packages/

RUN pnpm install --no-frozen-lockfile

# ============================================
# Stage 2: 构建
# ============================================
FROM node:20-alpine AS builder
WORKDIR /app

RUN corepack enable pnpm && pnpm config set registry https://registry.npmmirror.com

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/api/node_modules ./api/node_modules
COPY --from=deps /app/tenant-web/node_modules ./tenant-web/node_modules
COPY --from=deps /app/admin-web/node_modules ./admin-web/node_modules
COPY --from=deps /app/packages ./packages

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY tsconfig.base.json tsconfig.base.json
COPY tsconfig.react-package.json tsconfig.react-package.json
COPY api/package.json api/package.json
COPY tenant-web/package.json tenant-web/package.json
COPY admin-web/package.json admin-web/package.json
COPY packages/ packages/
COPY api/src api/src
COPY api/prisma api/prisma
COPY api/tsconfig.json api/
COPY tenant-web/src tenant-web/src
COPY tenant-web/public tenant-web/public
COPY tenant-web/vite.config.ts tenant-web/
COPY tenant-web/tsconfig.json tenant-web/
COPY tenant-web/tailwind.config.ts tenant-web/
COPY tenant-web/postcss.config.mjs tenant-web/
COPY tenant-web/index.html tenant-web/
COPY admin-web/src admin-web/src
COPY admin-web/vite.config.ts admin-web/
COPY admin-web/tsconfig.json admin-web/
COPY admin-web/tailwind.config.ts admin-web/
COPY admin-web/postcss.config.mjs admin-web/
COPY admin-web/index.html admin-web/

# 构建 api-contract
RUN pnpm --filter @propease/api-contract run build

# 构建 tenant-web
WORKDIR /app/tenant-web
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm run build

# 构建 admin-web
WORKDIR /app/admin-web
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm run build

# ============================================
# Stage 3: 输出构建产物到共享卷
# 基于 nginx:alpine，仅用于初始化共享卷
# ============================================
FROM nginx:alpine AS runner

COPY --from=builder /app/tenant-web/dist /usr/share/nginx/html/tenant
COPY --from=builder /app/admin-web/dist /usr/share/nginx/html/admin

CMD ["sh", "-c", "cp -r /usr/share/nginx/html/* /usr/share/nginx/html/ && exit 0"]
