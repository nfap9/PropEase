# =========================================
# Middleware 环境配置（PostgreSQL / Redis）
# =========================================
# 使用方式:
#   cp docker/.env.middleware.example docker/middleware.env
#   docker compose -f docker/docker-compose.middleware.yaml --env-file docker/middleware.env up -d
# =========================================

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=apartment_ultra
POSTGRES_PORT=5432

REDIS_PORT=6379

# ---- 本地访问地址（供本地开发前端连接）----
# PostgreSQL: localhost:5432
# Redis: localhost:6379
