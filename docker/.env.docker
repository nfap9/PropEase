# =========================================
# Apartment Ultra 本地 Docker 环境配置
# =========================================
# 使用方法:
#   本地开发（推荐，只启动中间件）:
#     docker compose -f docker/docker-compose.middleware.yaml up -d
#
#   本地完整部署（测试用）:
#     docker compose -f docker/docker-compose.yaml --env-file docker/.env.docker up -d
#
#   生产部署:
#     docker compose -f docker/docker-compose.yaml --env-file .env.production up -d
# =========================================

# ---- 数据库配置 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=apartment_ultra
POSTGRES_PORT=5432

# ---- Redis 配置 ----
REDIS_PORT=6379

# ---- API 配置 ----
APP_NAME=Apartment Ultra API
# 本地开发用密钥（生产环境请更换）
SECRET_KEY=local-dev-secret-key-do-not-use-in-production-32chars
ADMIN_INIT_PASSWORD=Admin@123456
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
API_PORT=8000

# ---- CORS 配置 ----
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000","http://localhost:3001"]

# ---- 前端配置 ----
# 注意：admin-web 使用 /admin 路径，NEXT_PUBLIC_API_URL 不包含 /admin
NEXT_PUBLIC_API_URL=http://localhost/api/v1
TENANT_WEB_PORT=3000

# ---- Nginx 配置 ----
NGINX_PORT=80
SERVER_NAME=localhost

# ---- 微信支付配置（本地禁用）----
WECHAT_PAY_ENABLED=false

# ---- 资源限制（可选，本地开发可不设置）----
# POSTGRES_MEMORY=1G
# API_MEMORY=1G
# WEB_MEMORY=1G
# ADMIN_MEMORY=1G
