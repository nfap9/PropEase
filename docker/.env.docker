# =========================================
# Apartment Ultra 本地 Docker 环境配置
# =========================================
# 使用方法:
#   docker compose -f docker/docker-compose.local.yaml --env-file docker/.env.docker up -d
# =========================================

# ---- 数据库配置 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=apartment_ultra

# ---- API 配置 ----
APP_NAME=Apartment Ultra API
# 本地开发用密钥（生产环境请更换）
SECRET_KEY=local-dev-secret-key-do-not-use-in-production-32chars
ADMIN_INIT_PASSWORD=Admin@123456
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS 配置 ----
CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000","http://localhost:3001"]

# ---- 前端配置 ----
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# ---- 微信支付配置（本地禁用）----
WECHAT_PAY_ENABLED=false
