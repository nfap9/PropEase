# =========================================
# 本地 Docker 完整部署测试环境
# =========================================
# 使用方式:
#   docker compose -f docker/docker-compose.yaml --env-file docker/.env.docker up -d
# =========================================

# ---- 数据库 ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=apartment_ultra

# ---- Redis ----
REDIS_PORT=6379

# ---- API ----
SECRET_KEY=dev-secret-key-for-testing-only-32chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
CORS_ORIGINS=["http://localhost","http://localhost:3000","http://localhost:8080"]

# ---- 前端 ----
NEXT_PUBLIC_API_URL=http://localhost/api/v1

# ---- 端口 ----
API_PORT=8000
TENANT_WEB_PORT=3000
ADMIN_WEB_PORT=8080
NGINX_PORT=80

# ---- Nginx ----
SERVER_NAME=localhost

# ---- 微信支付 ----
WECHAT_PAY_ENABLED=false
